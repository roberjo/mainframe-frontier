//SETUP    JOB (FFB,0001),'CATALOG AND LOAD',CLASS=A,MSGCLASS=X
//*
//* FIRST FRONTIER BANK - ONE-TIME ENVIRONMENT SETUP
//*
//* DEFINES THE GENERATION DATA GROUPS USED BY THE NIGHTLY CYCLE AND
//* LOADS GENERATION 1 OF THE ACCOUNT MASTER FROM THE CONVERSION FEED.
//* RERUNNABLE: THE DELETES CLEAR ANY PREVIOUS ENVIRONMENT FIRST.
//*
//DEFGDG   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  /* START CLEAN - IGNORE 'NOT FOUND' ON A FIRST RUN */
  DELETE FFB.ACCTMAST       GDG FORCE
  DELETE FFB.DAILY.POSTLOG  GDG FORCE
  DELETE FFB.DAILY.INTLOG   GDG FORCE
  DELETE FFB.HIST.TRANFEED  GDG FORCE
  SET MAXCC = 0

  DEFINE GDG (NAME(FFB.ACCTMAST)      LIMIT(7)  NOEMPTY SCRATCH)
  DEFINE GDG (NAME(FFB.DAILY.POSTLOG) LIMIT(30) NOEMPTY SCRATCH)
  DEFINE GDG (NAME(FFB.DAILY.INTLOG)  LIMIT(30) NOEMPTY SCRATCH)
  DEFINE GDG (NAME(FFB.HIST.TRANFEED) LIMIT(30) NOEMPTY SCRATCH)
/*
//*
//LOADMAST EXEC PGM=ACCTLOAD,COND=(0,LT)
//ACCTIN   DD DSN=FFB.SEED.ACCTLOAD,DISP=SHR
//ACCTOUT  DD DSN=FFB.ACCTMAST(+1),DISP=(NEW,CATLG,DELETE),
//            RECFM=FB,LRECL=100
//SYSOUT   DD SYSOUT=*
//*
//LISTCAT  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(FFB.**)
/*
